# ---- 공개 가능 (브라우저 노출) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- 서버/워커 전용 (절대 NEXT_PUBLIC_ 접두사 금지) ----
SUPABASE_SERVICE_ROLE_KEY=
TRIGGER_SECRET_KEY=

# Provider 모드: mock(기본) | live
PROVIDER_MODE=mock
# 실제 Instagram 게시: mock(기본) | live  ← 사용자 승인 전 live 금지
PUBLISH_MODE=mock

# Live provider (M3~)
ANTHROPIC_API_KEY=
SCENE_VIDEO_API_KEY=
TTS_API_KEY=

# Instagram (M4~)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# Remotion 라이선스 키 (Company License 대상일 때만)
REMOTION_LICENSE_KEY=

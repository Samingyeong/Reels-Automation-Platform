# 로컬: `npm run db:start` 후 `npx supabase status -o env` 값을 사용 (API_URL, PUBLISHABLE_KEY, SECRET_KEY)

# ---- 공개 가능 (브라우저 노출) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- 서버/워커 전용 (절대 NEXT_PUBLIC_ 접두사 금지) ----
SUPABASE_SECRET_KEY=

# 작업 실행 방식: inline(기본, 개발·개인용 MVP) | none(outbox 기록만) | trigger(M2: Trigger.dev)
JOB_DISPATCH_MODE=inline
TRIGGER_SECRET_KEY=

# Provider 모드: mock(기본) | live  ← live 는 유료 API 비용 확인·승인 후에만
PROVIDER_MODE=mock
# 실제 Instagram 게시: mock(기본) | live  ← 실제 게시 테스트는 별도 사용자 승인 후에만
PUBLISH_MODE=mock

# Live provider (M3~, 미선정: docs/decisions.md DR-004)
ANTHROPIC_API_KEY=
SCENE_VIDEO_API_KEY=
TTS_API_KEY=

# Instagram API with Instagram Login (M4~, docs/decisions.md DR-002)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v27.0

# Remotion: 개인 무료 라이선스 사용 중이므로 비워 둔다 (docs/decisions.md DR-001)
REMOTION_LICENSE_KEY=

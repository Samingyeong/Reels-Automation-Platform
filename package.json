{
  "name": "reels-automation-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run remotion:bundle && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "remotion": "remotion studio",
    "render": "remotion render Reel out/reel.mp4 --is-production=false",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,realtime,postgres-meta",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript > src/server/database.types.ts",
    "remotion:bundle": "remotion bundle src/remotion/index.ts --out-dir=.remotion-bundle --quiet",
    "trigger:dev": "trigger.dev dev",
    "trigger:deploy": "trigger.dev deploy",
    "test:e2e": "playwright test",
    "env:local": "node scripts/local-env.mjs > .env.local"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@remotion/bundler": "4.0.547",
    "@remotion/cli": "4.0.547",
    "@remotion/google-fonts": "4.0.547",
    "@remotion/lambda": "4.0.547",
    "@remotion/paths": "4.0.547",
    "@remotion/player": "4.0.547",
    "@remotion/renderer": "4.0.547",
    "@remotion/shapes": "4.0.547",
    "@remotion/tailwind-v4": "4.0.547",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "@trigger.dev/sdk": "4.8.10",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.79.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.547",
    "server-only": "0.0.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.63.0",
    "@remotion/eslint-plugin": "4.0.547",
    "@tailwindcss/postcss": "4.2.0",
    "@trigger.dev/build": "4.8.10",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web": "0.0.166",
    "dotenv": "17.3.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.23",
    "prettier": "3.8.1",
    "supabase": "3.4.0",
    "tailwindcss": "4.2.0",
    "trigger.dev": "4.8.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "overrides": {
    "@remotion/eslint-plugin": {
      "@typescript-eslint/utils": "8.73.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "supabase@3.4.0": true,
    "esbuild@0.28.2": true,
    "@depot/cli": false
  },
  "packageManager": "npm@11.21.3"
}
